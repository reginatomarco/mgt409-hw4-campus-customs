# Copy this file to .env (in the hw4 folder) and fill in your own values.
# .env is ignored by git, so never commit real keys.

# Required for the chat assistant (products and login work without it).
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: gateway address and model (defaults shown).
PORTKEY_BASE_URL=https://api.portkey.ai/v1
CHAT_MODEL=gpt-4o-mini

# Optional: chat message limits (defaults shown).
CHAT_LIMIT_USER_PER_HOUR=20
CHAT_LIMIT_GUEST_PER_HOUR=10
CHAT_LIMIT_GLOBAL_PER_DAY=300

# Optional: key for signing login cookies. If unset, a random one is created in backend/.session_secret.
# SESSION_SECRET=replace-with-a-long-random-string
